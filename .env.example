# Copy to .env and fill in. The server reads this at boot (no dotenv needed).

# Port for the API + admin dashboard (and the whole site in production).
# API_PORT wins over a platform-provided PORT.
API_PORT=3001

# Password for http://localhost:3001/admin — pick something long and random.
# Admin login stays disabled until this is set.
ADMIN_PASSWORD=

# How long an admin login lasts before you're asked again.
SESSION_TTL_HOURS=12

# How long a customer stays logged in (days).
CUSTOMER_SESSION_TTL_DAYS=30

# "Sign in with Google" — your OAuth 2.0 Client ID from
# https://console.cloud.google.com/apis/credentials (Web application).
# It's a public value, safe to expose. Add http://localhost:5173 (dev) and
# your live domain under "Authorized JavaScript origins". Google sign-in is
# hidden on the site until this is filled in; email/password works regardless.
GOOGLE_CLIENT_ID=

# PostgreSQL connection string (Supabase Session pooler recommended).
# Schema is created automatically on first boot. Required in production.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Set to 1 when running behind a reverse proxy (Render, nginx, caddy) so rate
# limiting sees real client IPs.
# TRUST_PROXY=1

# Split deployment (frontend on Vercel, API here on Render): allowed browser
# origins for cross-origin API calls, comma-separated, no spaces, no trailing
# slash. Empty = reflect any origin (safe here — auth is a Bearer token, not
# cookies). MUST list EVERY live domain or that domain's API calls break (CORS).
# CORS_ORIGINS=https://gunji.vercel.app,https://gunji.live,https://www.gunji.live

# Telegram owner-alerts on every new order / custom-print request. Both must be
# set to enable; fire-and-forget, silently skipped if unset. Secrets — set in
# the Render dashboard, never commit (repo is public).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Google Apps Script web-app URL that appends orders/requests to a Google Sheet.
# Empty = skip.
# GSHEET_WEBHOOK_URL=

# Cold-start heartbeat: pings own /api/health to keep a Render Free instance
# warm. Render injects RENDER_EXTERNAL_URL automatically; HEARTBEAT_URL overrides
# it. Empty (local dev) = disabled. Interval must stay under the ~15min idle window.
# HEARTBEAT_URL=
# HEARTBEAT_MINUTES=10

# ---- Frontend build (Vercel), NOT read by this server ----
# The React app reads VITE_API_URL at BUILD time to know where the API lives.
# Set it in the Vercel project settings to this backend's URL, e.g.
# VITE_API_URL=https://gunji-api.onrender.com
# Leave it unset locally so the Vite dev proxy handles /api.
