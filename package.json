{
  "name": "gunji-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/db/seed.js"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "express": "^5.1.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vercel": "^54.21.1",
    "vite": "^5.4.11"
  }
}
